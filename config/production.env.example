AUTO_DEV_ENV=production
AUTO_DEV_ENV_FILE=__RUNTIME_ROOT__/config/production.env
AUTO_DEV_DATA_DIR=__RUNTIME_ROOT__/data
AUTO_DEV_WORKSPACES_ROOT=__RUNTIME_ROOT__/workspaces

# The production installer replaces __RUNTIME_ROOT__ with the selected path.
# Keep real credentials only in that runtime configuration file.
DEEPSEEK_API_KEY=replace_with_your_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=replace_with_actual_model_id

# Leave disabled until the controlled dry_run has been approved.
CODEX_ENABLED=false
CODEX_PATH=codex
CLAUDE_ENABLED=false
CLAUDE_PATH=claude
REVIEWER_MODE=deepseek
VERIFICATION_PROVIDER=kimi
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=high
KIMI_MAX_TOKENS=4096

OTEL_SDK_DISABLED=true
LITELLM_LOCAL_MODEL_COST_MAP=true
